entic_preflight/risk.py","agentic_preflight/runs/publish.py"],"medium_risk_paths":["agentic_preflight/**","tests/**","skill/**"]},"pr":{"automated_cleanup":true,"mode":"auto"},"review":{"blocking_severities":["critical","high"],"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","executor":"command","max_findings":50,"require_command_for":[]},"stage":{"max_attempts":5,"max_restarts":5,"timeout_seconds":1500},"worktree":{"copy_files":[".env"],"mode":"in_place","root":null,"setup_command":null}},"findings":[{"action":"auto_fix","code_owned":false,"detail":"render_markdown always adds _escape_section(overall). The existing hosted contract says hosted report content appears only when at least one run in the report was synced, and _hosted_sync_section follows that rule. Because of this, reports with no synced runs now show a seven-row table where every value is n/a. The golden report.md shows this: every denominator is 0.","fix_commit":"228aafc3b6424e5c07e5af35c7609012abc09e07","id":"F001","line":660,"path":"agentic_preflight/report/markdown.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Gate _escape_section on the same synced-run condition that _hosted_sync_section uses.","title":"Escape signals section is rendered even when no run in the report was synced","unit":"U0024"},{"action":"auto_fix","code_owned":false,"detail":"`assert \"telemetry\" not in cfg.model_dump(mode=\"json\")` appears twice in a row. It looks like a copy-paste slip, and the attestation snapshot path that this test is meant to cover is never asserted.","fix_commit":"2796bcf92d13c2f3bcbe05711278e32360cb57f8","id":"F002","line":582,"path":"tests/test_config.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Remove the duplicate line, or replace it with an assertion on the snapshot or digest input that attestations actually use.","title":"Duplicated assertion in hosted mapping config test","unit":"U0052"},{"action":"ask_user","code_owned":false,"detail":"`_escapes` runs inside the same `try` as `fetch`. Any `GhError` from the new PR commits, reviews, or comments endpoints, or from the opt-in revert scan, therefore takes the same path as a core fetch failure. Examples are a 403, a 404, or a rate limit. Unless the reason is in `_COMMIT_ERRORS`, the loop stops: the run's PR and check outcome, which were already fetched, are not written, and later runs are not synced. This contradicts the nullable, unknown-is-null design for these observations.","fix_commit":"9eb141fdada9be1924dd0243c29f29c16ea5cc08","id":"F003","line":740,"path":"agentic_preflight/hosted.py","response_note":null,"severity":"medium","stage":"review","status":"fixed","suggestion":"Catch `GhError` around the escape calls (or inside `_list_all`/`_reverted`) and record null for the affected observation, so `document` is still written. Alternatively, confirm with the user that the whole sync should stop when these endpoints fail.","title":"A failed optional escape request stops the whole sync instead of leaving the count null","unit":"U0017"},{"action":"ask_user","code_owned":false,"detail":"Before this change, `_check_runs` skipped items that were not mappings. Now it raises `invalid_response`, so a single bad entry fails the core outcome fetch for the run, not just the new `settled` classification.","fix_commit":null,"id":"F004","line":293,"path":"agentic_preflight/hosted.py","response_note":"The current diff restores malformed-entry tolerance and marks classification unknown in 2796bcf92d13c2f3bcbe05711278e32360cb57f8. 203 affected tests pass. In-place respond refuses to cite that already-registered repair commit twice; this note records the implemented repair, not acceptance of the defect.","severity":"low","stage":"review","status":"accepted","suggestion":"Keep skipping malformed items and set `checks.settled` to false when any are dropped.","title":"One malformed check-run item now aborts the run's sync instead of being skipped","unit":"U0011"},{"action":"auto_fix","code_owned":false,"detail":"`message.split(\"\\n\", 1)[-1]` returns the whole message when there is no newline. A one-line subject that contains the SHA then counts, although the docs require the full merge SHA in the body.","fix_commit":null,"id":"F005","line":455,"path":"agentic_preflight/hosted.py","response_note":"2796bcf92d13c2f3bcbe05711278e32360cb57f8 now searches only message.partition(newline)[2] for the Revert-subject fallback; a one-line subject containing the SHA is tested false. 203 affected tests pass. The repair commit is already registered, so this note records the implemented repair under already_fixed.","severity":"low","stage":"review","status":"accepted","suggestion":"Use `parts = message.split(\"\\n\", 1)` and search `parts[1]` only when `len(parts) == 2`.","title":"The `Revert \"...\"` match also searches the subject line of a one-line message","unit":"U0013"},{"action":"ask_user","code_owned":false,"detail":"`_human_count` skips accounts of type `Bot` and returns None for any type other than `User`. GitHub also reports `Organization` and `Mannequin` users, for example on migrated repositories. A single review or comment from one of those accounts discards every other observation, so `changes_requested` or `review_comments` becomes null for that PR. The run then drops out of the report denominator without notice.","fix_commit":null,"id":"F006","line":420,"path":"agentic_preflight/hosted.py","response_note":"User explicitly chose to keep the count null when human status is unknown, including Organization and Mannequin accounts. This preserves the unknown-is-null contract; excluding uncertain accounts would claim an exact human count without evidence.","severity":"low","stage":"review","status":"dismissed","suggestion":"Decide whether non-User, non-Bot accounts count as human or are skipped, and treat them the same way as bots instead of throwing away the whole count.","title":"One review or comment from a non-User, non-Bot account makes the whole human count unknown","unit":"U0016"},{"action":"no_op","code_owned":false,"detail":"`revert_requests` goes up as soon as a merged run is picked for a revert scan. If an earlier observation in `_escapes` hits a global stop, the scan never runs, but the slot is still counted. The loop breaks right after, so nothing visible changes today.","fix_commit":null,"id":"F007","line":776,"path":"agentic_preflight/hosted.py","response_note":"No observable effect: the invocation stops immediately on a global request failure and never uses the remaining revert budget. Keeping the bounded selection counter avoids unrelated refactoring.","severity":"low","stage":"review","status":"accepted","suggestion":null,"title":"The revert cap counts a slot as used even when the scan never runs","unit":"U0021"}],"fingerprint":{"base_tree_sha":"453ab1f851e78f9985cf3e96142575537ced1f89","config_sha256":"25363ddc7d586ecf84e8f7f7fa372aa5c9e7aa56e8216e0ac04452b84d670e9c","configuration_supported":true,"diff_sha256":"7158ffc22bfd0d62ad8ffcc99b140f38c06c6d0b463e277000d4f04b17a1b5f0","excluded_files":[],"executor":"command","grounding_sha256":"78d6223e197506946a511be1bd047d608cc5e963ced006820bccfb2edba07ee4","head_tree_sha":"fe898307d40254869b559ff48aeb4ccf588d6017","intent_sha256":"93d691b0982d2ba95400ab12bac3e8dfb143bed42a2c7da5e546ef3a3a53d0ae","version":2},"finished_at":"2026-11-17T04:38:38Z","head_sha":"9eb141fdada9be1924dd0243c29f29c16ea5cc08","result":{"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","coverage":{"cited_units":["U0016","U0021"],"clean_units":["U0001","U0002","U0003","U0004","U0005","U0006","U0007","U0008","U0009","U0010","U0011","U0012","U0013","U0014","U0015","U0017","U0018","U0019","U0020","U0022","U0023","U0024","U0025","U0026","U0027","U0028","U0029","U0030","U0031","