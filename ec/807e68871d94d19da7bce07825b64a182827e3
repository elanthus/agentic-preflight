runs/publish.py"],"medium_risk_paths":["agentic_preflight/**","tests/**","skill/**"]},"pr":{"automated_cleanup":true,"mode":"auto"},"review":{"blocking_severities":["critical","high"],"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","executor":"command","max_findings":50,"require_command_for":[]},"stage":{"max_attempts":5,"max_restarts":5,"timeout_seconds":1500},"worktree":{"copy_files":[".env"],"mode":"in_place","root":null,"setup_command":null}},"findings":[{"action":"ask_user","code_owned":false,"detail":"_Scrubber.text replaces every user-level command string anywhere inside every scrubbed value, with no word or quote boundary. A common short command such as `true`, `make`, `ok` or `pytest` then rewrites unrelated words in finding titles, details, notes, the intent and the commit subjects. For example, a lint command of `make` turns 'make the cache thread-safe' into '[redacted user-level command] the cache thread-safe', and `true` mangles 'construe'. The intent says finding text, notes and intent are kept as written. It also says a command quoted inside a longer value must be withheld. The code comment accepts over-redaction, but the request does not settle which requirement wins when the two conflict.","fix_commit":"71ac77a04977b3b68d10b0dff758f9abda6db0f9","id":"F001","line":null,"path":"agentic_preflight/report/audit.py","response_note":null,"severity":"medium","stage":"review","status":"fixed","suggestion":"Choose a rule. One option: replace a command inside a longer string only when it is quoted (backticks or quotes) or bounded by word boundaries, or only above a minimum length, and exempt the finding, note and intent fields. Another: keep the current behavior and document that short commands can redact ordinary words.","title":"Short user-level commands are replaced as raw substrings in all run text, which corrupts finding text and the intent","unit":"U0009"},{"action":"auto_fix","code_owned":false,"detail":"_Scrubber.__call__ returns the value unchanged whenever its key is in _CONTROL_KEYS, whatever the value's type or location. The bypass is meant for enum strings the renderer selects by. But the scrubber also walks raw events from the event log, which are untrusted and arbitrary. A raw event field named `name`, `action`, `kind`, `state`, `from` or `to` that holds a local path, a user-level command, or a dict of such values is kept unredacted in the shareable report.","fix_commit":null,"id":"F002","line":null,"path":"agentic_preflight/report/audit.py","response_note":"Fixed in 71ac77a0 together with F001: redaction now skips a value only when it is a member of the fixed vocabularies under a key that holds one, so a path or command under name or state in a raw event is redacted. Covered by test_a_fixed_word_is_kept_only_where_it_is_one.","severity":"low","stage":"review","status":"dismissed","suggestion":"Apply the bypass only to scalar strings, and only in the tool-built sections the renderer reads (stages, findings, actors, timeline rows), not inside timeline raw events. Or keep the bypass only when the value is a member of the known enum for that key.","title":"The control-key bypass skips redaction of any value under keys such as name, action, kind or state, including nested dicts and lists","unit":"U0009"},{"action":"auto_fix","code_owned":false,"detail":"In the shareable view, build_audit drops the event keys that name a remote, masks the remote's name inside refs/remotes/<name>/, and sets run.remote to None. But _withheld_summary lists only absolute local paths, user-level configuration sections, and user-level commands. The README and CHANGELOG both say the default report leaves out remote names, so the page's own list of what was withheld is incomplete.","fix_commit":"c027136cf1a639d19153ce6056439196531481cb","id":"F003","line":748,"path":"agentic_preflight/report/audit.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Have _withheld_summary always add an item such as 'remote names, and the keys that name a Git remote in raw events, shown as <remote> in refs'.","title":"The shareable view's 'Left out of this copy' list never mentions remote names","unit":"U0009"},{"action":"auto_fix","code_owned":false,"detail":"build_audit's _capture can read the records again from a newer run record when the run moves during capture, so the HTML can show a later state. audit() still builds the envelope with envelope_for(run, ...), where run is the record _select loaded before the capture. The envelope's state can then disagree with the report and with data.chain_status and findings_by_status, which come from the newer capture.","fix_commit":null,"id":"F004","line":84,"path":"agentic_preflight/runs/audit.py","response_note":"Fixed in c027136c: the audit command now builds its envelope from the run record the report was captured from (captured_audit returns it), so the envelope's state agrees with the page. Covered by test_the_envelope_describes_the_run_the_report_shows.","severity":"low","stage":"review","status":"dismissed","suggestion":"Return the captured RunDoc from build_audit, or reload it, and pass that record to envelope_for.","title":"The envelope reports the run as first loaded, not the run the report shows","unit":"U0013"},{"action":"auto_fix","code_owned":false,"detail":"_Scrubber.text replaces only the roots that _local_roots lists: the run store, the worktrees, the repository, the caller root, and home. Any other absolute path is withheld only when its key ends in 'path' (the _is_absolute check in __call__). An error, a reason, or a detail string from the untrusted event log can name a path such as /opt/..., /private/var/..., or a temporary directory on another volume. That path stays in the report, although the intent, COMPATIBILITY.md, and the withheld list all say the shareable default leaves out absolute local paths.","fix_commit":"ec807e68871d94d19da7bce07825b64a182827e3","id":"F005","line":null,"path":"agentic_preflight/report/audit.py","response_note":null,"severity":"medium","stage":"review","status":"fixed","suggestion":"Mask absolute path-like tokens in free text as well, for example with a regex over POSIX and Windows drive paths, after the root replacement. Add a test with an event reason that names a path outside the roots.","title":"Absolute paths outside the known roots stay in free text in the shareable view","unit":"U0009"},{"action":"auto_fix","code_owned":false,"detail":"The new Audit report section says the file leaves out remote names without qualification. By design, the scrubber masks only refs/remotes/<name>/ and the keys that name a remote. A short-form ref such as origin/main in base_ref or in event text keeps the remote name. A reader could share the file believing no remote name remains.","fix_commit":null,"id":"F006","line":null,"path":"README.md","response_note":"Fixed in ec807e68: the README, the changelog fragment, the page's own list, and the command reference now say that remote URLs are left out, that a remote's name in a refs/remotes/ ref is shown as <remote>, and that a short ref such as origin/main is kept.","severity":"low","stage":"review","status":"dismissed","suggestion":"Qualify the sentence, for example: 'remote URLs, and the remote's name inside refs/remotes/ refs; a short ref such as origin/main is kept.'","title":"The README says remote names are left out, but short-form refs such as origin/main are kept","unit":"U0002"}],"fingerprint":{"base_tree_sha":"4a002316dcca2f47201c9f8750b5ab20be6cd43b","config_sha256":"25363ddc7d586ecf84e8f7f7fa372aa5c9e7aa56e8216e0ac04452b84d670e9c","configuration_supported":true,"diff_sha256":"59eef861c50709beedc7574ee6588b3e3dae391e28a84ec901652c7e3e0afc5e","excluded_files":[],"executor":"command","grounding_sha256":"6c2f00c7bf56e0cf9883e2affd7b09fd40265c2483ef918058942b0a35bb2b3d","head_tree_sha":"3ef3f723e9d62747e164d221f4dd1b85aae986