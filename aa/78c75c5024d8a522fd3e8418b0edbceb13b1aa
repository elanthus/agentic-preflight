light/cli_policy.py","agentic_preflight/hook.py","agentic_preflight/risk.py","agentic_preflight/runs/publish.py"],"medium_risk_paths":["agentic_preflight/**","tests/**","skill/**"]},"pr":{"automated_cleanup":true,"mode":"auto"},"review":{"blocking_severities":["critical","high"],"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","executor":"command","max_findings":50,"require_command_for":[]},"stage":{"max_attempts":5,"max_restarts":5,"timeout_seconds":1500},"worktree":{"copy_files":[".env"],"mode":"in_place","root":null,"setup_command":null}},"findings":[{"action":"auto_fix","code_owned":false,"detail":"In diff_text_by_path_bounded, when the read stops early (complete is False), _check_binary_markers runs only on `read`, the paths from the group that stopped. If the text group finishes and the read then stops inside the binary group, the text-group paths are already in per_file and are returned in BoundedPatches, but their strict binary-marker check never runs. The full read in diff_text_by_path checks every path. So if `--text` ever failed to cover a case, an early-stopped read could return a hidden-content marker without refusing it, which breaks the docstring's claim of 'the same ... refusals ... as diff_text_by_path'.","fix_commit":"745c3dd3d5389c1581549f6ab9ca7895fe07c63f","id":"F001","line":1693,"path":"agentic_preflight/gitx.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Before returning on an incomplete read, check every path in per_file, not just `read`: `for path in per_file: _check_binary_markers(path, per_file[path], entries[path], binary, strict=True)`. Add a test where the text group completes and the binary group stops.","title":"Early-stopped bounded read skips binary-marker checks for paths read in an earlier group","unit":"U0017"},{"action":"ask_user","code_owned":false,"detail":"Paths with a binary blob on either side go through the diff without `--text`. If the path is a type change, such as a binary file replaced by a symlink, the symlink side is a text block judged by Git's own heuristic. When `$GIT_DIR/info/attributes` sets `-diff` on that path, Git prints a binary marker for the symlink block too. The strict `_check_binary_markers` then raises ReviewDiffError: 'Git reported \u2026 as binary, but its content is text. A Git attribute hides this patch from review.' COMPATIBILITY.md, fingerprint-contract.md and the code comments all say `-diff` in the info file has no effect. Content stays visible because the command refuses, but the refusal goes against the documented contract, and its message does not tell the user which info/attributes entry to remove.","fix_commit":"aa78c75c5024d8a522fd3e8418b0edbceb13b1aa","id":"F002","line":1560,"path":"agentic_preflight/gitx.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Decide between two fixes. One: build each block of a binary type change with the right flags, for example by passing `--text` and relying on `_binary_blobs` to emit the marker for binary blocks. Two: document this case and make the strict message name `$GIT_DIR/info/attributes`. Add a test that combines a binary-to-symlink type change with `* -diff` in info/attributes.","title":"`-diff` in info/attributes can refuse a type change that has one binary side, though the docs say it has no effect","unit":"U0016"}],"fingerprint":{"base_tree_sha":"07e9efe4b0afbbcd77fe9375c56d000b9491508e","config_sha256":"25363ddc7d586ecf84e8f7f7fa372aa5c9e7aa56e8216e0ac04452b84d670e9c","configuration_supported":true,"diff_sha256":"13eecdc7eab19c64a2fdc3ec363bdcadb6cb9ce326c48d90de41ad8c7899c90d","excluded_files":[],"executor":"command","grounding_sha256":"7c114bb3812d11561c39acd08ac7463759b6e4bc2755b02b6ad05abb3da7c613","head_tree_sha":"952ce2598ee4cf7f6a2c76d85e06709885f3fa68","intent_sha256":"3dcc5b8d60abe50a5a25c0b28a856858ca6a2420b1b17c0214d66be2d05855a1"