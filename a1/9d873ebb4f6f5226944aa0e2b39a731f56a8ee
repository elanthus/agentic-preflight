de":"auto"},"review":{"blocking_severities":["critical","high"],"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","executor":"command","max_findings":50,"require_command_for":[]},"stage":{"max_attempts":5,"max_restarts":5,"timeout_seconds":1500},"worktree":{"copy_files":[".env"],"mode":"in_place","root":null,"setup_command":null}},"findings":[{"action":"auto_fix","code_owned":false,"detail":"The command now reads stdin as strict UTF-8. read_context only catches JSONDecodeError and OSError. If stdin holds bytes that are not valid UTF-8, json.load raises UnicodeDecodeError. That error is a ValueError but not a JSONDecodeError, so it escapes as a Python traceback. The documented contract is exit 1 with one 'independent reviewer failed: ...' line on stderr. Under a cp1252 locale the old wrapper decoded any byte, so this failure mode is new on Windows.","fix_commit":"8ec3d1e9a2572e0e17e8ac9f9ada857a7fbb6730","id":"F001","line":27,"path":"agentic_preflight/reviewers/common.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Also catch UnicodeDecodeError in read_context and raise ReviewerError.","title":"Non-UTF-8 review context crashes with a traceback instead of the one-line reviewer diagnostic","unit":"U0018"},{"action":"auto_fix","code_owned":false,"detail":"The bare `except ImportError` around `from agentic_preflight.reviewers.claude import main` also catches ImportErrors raised inside an installed package, such as an outdated install that lacks the reviewers subpackage. The message then says the package is not importable, which hides the real cause. The same applies to codex_review.py.","fix_commit":null,"id":"F002","line":17,"path":"docs/examples/reviewers/claude_review.py","response_note":"Fixed in 8ec3d1e before this review round: both pointers now include the ImportError text in the message, and test_pointer_without_the_package_names_the_replacement_command asserts 'No module named' appears.","severity":"low","stage":"review","status":"dismissed","suggestion":"Catch ModuleNotFoundError and check that exc.name starts with 'agentic_preflight', or include the exception text in the message.","title":"Pointer reports 'cannot import agentic_preflight' for any ImportError, including failures inside the package","unit":"U0032"},{"action":"auto_fix","code_owned":false,"detail":"NO_GIT_CHECK in cli.py matches on ctx.invoked_subcommand == 'reviewer'. So `reviewer --help` and any future reviewer subcommand also skip the Git version check. commands.md and COMPATIBILITY.md describe only `reviewer run` as exempt.","fix_commit":null,"id":"F003","line":29,"path":"skill/reference/commands.md","response_note":"Fixed in 8ec3d1e before this review round: commands.md, COMPATIBILITY.md and ADR 0003 now say the whole reviewer group (whose only command is reviewer run) skips the Git version check, matching NO_GIT_CHECK.","severity":"low","stage":"review","status":"dismissed","suggestion":"Either describe the exemption as applying to the `reviewer` command group, or narrow the check to `reviewer run`.","title":"Docs say only `reviewer run` skips the Git check, but the code skips it for the whole `reviewer` group","unit":"U0046"},{"action":"ask_user","code_owned":false,"detail":"run_cli calls subprocess.run(..., text=True) without encoding=. The prompt sent to the provider CLI is encoded with the locale encoding, and the CLI's stdout and stderr are decoded with it too, except in the events-file path, which reads the file as UTF-8. On Windows with a cp1252 locale, a diff or intent containing characters outside cp1252 raises an uncaught UnicodeEncodeError, which ReviewerError handling does not catch. The command then exits with a traceback instead of the documented single 'independent reviewer failed: ...' line. The wrappers behaved the same way, but the change, its changelog fragment, and COMPATIBILITY.md now advertise UTF-8 I/O, which only holds for the reviewer's own streams.","fix_commit":"a19d873ebb4f6f5226944aa0e2b39a731f56a8ee","id":"F004","line":176,"path":"agentic_preflight/reviewers/common.py","response_note":"Took the documentation option: step 1 is scoped to no behaviour change, so the provider pipe keeps the wrappers' locale encoding. run_cli now says so, and COMPATIBILITY.md, the added fragment, independent-review.md and ADR 0003 (8080c47) limit the UTF-8 claim to the reviewer's own streams.","severity":"low","stage":"review","status":"fixed","suggestion":"Either pass encoding='utf-8' (and errors='replace' on output) to both subprocess.run calls and catch UnicodeError as a ReviewerError, or say in the docs that the provider CLI pipe keeps the locale encoding in step 1.","title":"The provider CLI subprocess still uses the locale encoding, so UTF-8 handling only covers the reviewer's own standard streams","unit":"U0018"}],"fingerprint":{"base_tree_sha":"c8992f33a7f6613e053a114e91b243c36a97d07b","config_sha256":"47de23995384e97c1f2cfdaf65f0f5392e876c6a60064aa0be584ac5e453621c","configuration_supported":true,"diff_sha256":"d730fc93c79628740034f2f8118c97739a5386f252d665fda798179a76dcff2d","excluded_files":[],"executor":"command","grounding_sha256":"3fb7b6da8f2abf25f940d8c9b723fb30025aa626e5734c8fbf0300ed64fb697f","head_tree_sha":"c383206a75b5b34a92417ab1a8dda862758a02ac","intent_sha256":"1065adc9d662ac1acb014feeea6e43e9ee26c5cfcc53a0dd6cf10a30d73c43ef","version":2},"finished_at":"2026-11-14T03:36:56Z","head_sha":"a19d873ebb4f6f5226944aa0e2b39a731f56a8ee","result":{"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","coverage":{"cited_units":[],"clean_units":["U0001","U0002","U0003","U0004","U0005","U0006","U0007","U0008","U0009","U0010","U0011","U0012","U0013","U0014","U0015","U0016","U0017","U0018","U0019","U0020","U0021","U0022","U0023","U0024","U0025","U0026","U0027","U0028","U0029","U0030","U0031","U0032",