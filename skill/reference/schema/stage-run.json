    "validation_restarted": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Restarted"
    },
    "validation_restarts": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Restarts"
    }
  },
  "title": "agentic-preflight stage run data",
  "type": "object"
}
