{
  "$defs": {
    "Candidate": {
      "properties": {
        "command": {
          "title": "Command",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "command",
        "source"
      ],
      "title": "Candidate",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "attempts": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempts"
    },
    "baseline_red": {
      "default": null,
      "title": "Baseline Red"
    },
    "candidates": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidates"
    },
    "command": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command"
    },
    "copied_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
