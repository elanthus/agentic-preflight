    "Producer": {
      "additionalProperties": false,
      "description": "Which tool, interpreter, and coding agent created a run.\n\nInformational only: never attested, fingerprinted, or digested. The tool\nfields are code-derived. ``client`` comes from a flag or a documented\nenvironment marker, and ``reported_model`` is the agent's self-report; each\ncarries its provenance so a reader never mistakes a claim for a measurement.",
      "properties": {
        "client": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client"
        },
        "client_source": {
          "anyOf": [
            {
              "enum": [
                "flag",
                "environment"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Source"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "reported_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Model"
        },
        "reported_model_source": {
          "anyOf": [
            {
              "const": "flag",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Model Source"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "python_version",
        "platform"
      ],
      "title": "Producer",
      "type": "object"
    }
