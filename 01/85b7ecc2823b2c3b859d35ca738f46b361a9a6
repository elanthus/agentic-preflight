runs/publish.py"],"medium_risk_paths":["agentic_preflight/**","tests/**","skill/**"]},"pr":{"automated_cleanup":true,"mode":"auto"},"review":{"blocking_severities":["critical","high"],"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","executor":"command","max_findings":50,"require_command_for":[]},"stage":{"max_attempts":5,"max_restarts":5,"timeout_seconds":1500},"worktree":{"copy_files":[".env"],"mode":"in_place","root":null,"setup_command":null}},"findings":[{"action":"ask_user","code_owned":false,"detail":"_without_remotes drops only the keys remote, sync_remote and remote_url. Ref strings that contain a remote name are kept. The checked-in example shows this: its worktree_ready event has sync.base_ref = \"refs/remotes/origin/main\". run.base_ref and other ref fields can carry a remote name in the same way. The intent says the default report withholds remote names.","fix_commit":null,"id":"F001","line":742,"path":"agentic_preflight/report/audit.py","response_note":"A remote-qualified ref such as refs/remotes/origin/main names a remote but cannot hold a URL or credentials, which is what the shareable view withholds. The published attestation note already carries the base ref and branch. The report keeps ref values as written and drops only the keys that hold a remote itself.","severity":"low","stage":"review","status":"accepted","suggestion":"Decide whether remote-qualified refs count as remote names. If they do, rewrite the refs/remotes/<name>/ prefix and a leading <remote>/ prefix to a marker in the default view, and add a test for it.","title":"Shareable report still exposes remote names inside ref values","unit":"U0008"},{"action":"auto_fix","code_owned":false,"detail":"The audit command works for runs in any state, including active ones such as REVIEW_AWAITING_FINDINGS. The masthead labels run.state as 'Final state' no matter what, so a report on an in-progress run says the state is final when it is not. data['summary']['terminal'] already records whether the state is terminal.","fix_commit":"64c557f966548e13b40f6fabe497365b9d6435c9","id":"F002","line":150,"path":"agentic_preflight/report/audit_html.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Use 'Final state' only when summary.terminal is true, and 'Current state' otherwise.","title":"Masthead calls the current state 'Final state' for runs that are still active","unit":"U0009"},{"action":"auto_fix","code_owned":false,"detail":"`_without_remotes` removes only the keys `remote`, `sync_remote` and `remote_url`. Ref strings that contain a remote name are left alone. The checked-in example shows this: raw event 9 (`worktree_ready`) keeps `\"sync\": {\"base_ref\": \"refs/remotes/origin/main\"}`. `run.base_ref` and other event fields can carry the same `refs/remotes/<name>/...` form. The intent says remote names are withheld by default, so the default report is not doing what it claims.","fix_commit":null,"id":"F003","line":735,"path":"agentic_preflight/report/audit.py","response_note":"Fixed by commit 8dda6abe in this run: the shareable view shows the remote's name inside refs/remotes/<name>/ as a marker, with a test. That commit was cited for F004, and in-place mode takes one fixed response for each new commit.","severity":"medium","stage":"review","status":"dismissed","suggestion":"In the non-local scrub, rewrite `refs/remotes/<name>/` to a marker such as `refs/remotes/<remote>/` in every string. Add a test that checks the remote name (`origin`) appears nowhere in the shareable HTML.","title":"The shareable report still shows remote names inside ref values","unit":"U0008"},{"action":"auto_fix","code_owned":false,"detail":"`_Scrubber.text` returns `REDACTED_COMMAND` only when `value in self.commands`, so the whole string has to match the command. Any longer string that contains a user-level command keeps it in full. Examples are an event `reason` or `error`, or a stage `reason` that quotes the command line. The command may hold a secret such as `SAMPLE_TOKEN=...`. That text reaches the default 'shareable' report even though the docs say user-level commands are withheld.","fix_commit":"8dda6abeb462c18005795f34c1e6fd652716eb5d","id":"F004","line":596,"path":"agentic_preflight/report/audit.py","response_note":null,"severity":"medium","stage":"review","status":"fixed","suggestion":"Also replace each user command where it appears inside a longer string, checking the longest commands first, the same way local roots are replaced. Extend the privacy test with an event field that embeds the command.","title":"A user-level command is redacted only when a string equals it exactly","unit":"U0008"},{"action":"auto_fix","code_owned":false,"detail":"When attestation.read raises InvalidAttestation, _attestation sets present=True and valid=False but never sets a verification entry. So note_verified comes out as null. The AuditData description and commands.md say null means there is no note or the check could not run, and false means the note does not verify. A note that is present but malformed cannot verify, yet the envelope does not say false. A consumer that tests note_verified is False will miss this case.","fix_commit":"0185b7ecc2823b2c3b859d35ca738f46b361a9a6","id":"F005","line":61,"path":"agentic_preflight/runs/audit.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"In _attestation's InvalidAttestation branch, set verification={'ok': False, 'reason': exc.reason, 'detail': str(exc)}, or set note_verified=False whenever present is true and valid is false. Add a test with a note that cannot be parsed.","title":"A malformed note gives note_verified null instead of false","unit":"U0012"},{"action":"auto_fix","code_owned":false,"detail":"The shareable view is meant to withhold remote names. It does this by dropping the remote keys from events and by matching refs that start with refs/remotes/<name>/. But run.base_ref goes into the run section unchanged, and the scrubber only matches the full refs/remotes/ prefix. If the base is configured in the short form, such as origin/main, the remote's name shows in the masthead's Base field and in the raw config_snapshot (general.base_ref).","fix_commit":null,"id":"F006","line":683,"path":"agentic_preflight/report/audit.py","response_note":"A short-form base ref such as origin/main shows the remote's name, not its URL, and the published attestation note already carries the same base ref. The shareable view withholds the remote itself and the name inside refs/remotes/<name>/. Masking the short form would need the repository's remote names at report time and is left for a follow-up.","severity":"low","stage":"review","status":"accepted","suggestion":"Also mask the short form <remote>/<branch>. The remote names are known from the repository, so match against those when local_details is false. Add a test with base_ref set to origin/main.","title":"A remote's name in a short-form base ref is not withheld","unit":"U0008"}],"fingerprint":{"base_tree_sha":"4a002316dcca2f47201c9f8750b5ab20be6cd43b","config_sha256":"25363ddc7d586ecf84e8f7f7fa372aa5c9e7aa56e8216e0ac04452b84d670e9c","configuration_supported":true,"diff_sha256":"c98dc5786c756d550d6f764d71b76b28dfe7b0eef608aa58d91756571c8f42a6","excluded_files":[],"executor":"command","grounding_sha256":"1c69f6ec1cc9baac5a29e5c84578b42da4115175987df87683c40dd9c8eff1a5","head_tree_sha":"019f5d18fd200b08555d18977f2914758829704f","intent_sha256":"931e6256ac3c82300323cc21341045e579a00d6dc44803273c69a70dfe87e1e3","version":2},"finished_at":"2026-11-19T01:05:47Z","head_sha":"0185b7ecc2823b2c3b859d35ca738f46b361a9a6","result":{"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","coverage":{"cited_units":["U0008"],"clean_units":["U0001","U0002","U0003","U0004","U0005","U0006","U0007","U0009","U0010","U