preflight/cli_policy.py","agentic_preflight/hook.py","agentic_preflight/risk.py","agentic_preflight/runs/publish.py"],"medium_risk_paths":["agentic_preflight/**","tests/**","skill/**"]},"pr":{"automated_cleanup":true,"mode":"auto"},"review":{"blocking_severities":["critical","high"],"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","executor":"command","max_findings":50,"require_command_for":[]},"stage":{"max_attempts":5,"max_restarts":5,"timeout_seconds":1500},"worktree":{"copy_files":[".env"],"mode":"in_place","root":null,"setup_command":null}},"findings":[{"action":"auto_fix","code_owned":false,"detail":"In shellstage.py, `_GROUP_SIGNAL_CAN_MISS_A_FORK = sys.platform != \"linux\"` turns on the repeated kill for macOS and the BSDs, as the code comment says. The parent-death watcher repeats the kill on every platform, Linux included. The fragment says the change applies \"On macOS\" and that Linux \"was not affected\". That undersells where the behavior changed: BSD users get the new loop, and the Linux watcher now signals repeatedly for up to two seconds.","fix_commit":"f4ff536b2f0775d3729715a138b628bb9cad0f2c","id":"F001","line":1,"path":"docs/CHANGELOG.d/group-kill-misses-forking-process.fixed.md","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Say macOS and the BSDs (or \"platforms other than Linux\") for kill_process_tree. Optionally note that the parent-death watcher repeats the kill on every platform.","title":"Changelog says the fix is macOS-only, but it applies to every non-Linux POSIX platform","unit":"U0005"},{"action":"ask_user","code_owned":false,"detail":"`_kill_process_group` stops when `killpg` raises. The docstring counts on macOS raising PermissionError once only unreaped members are left. `_GROUP_SIGNAL_CAN_MISS_A_FORK` is also true for every other non-Linux POSIX platform, such as the BSDs. If one of those lets you signal a group whose leader is a zombie, which Linux does, then `kill_process_tree` called before `wait()` keeps signalling until `_GROUP_KILL_SECONDS` runs out. That adds two seconds to every timeout or cancellation there. The new test that pins Linux to one signal shows the same risk.","fix_commit":null,"id":"F002","line":219,"path":"agentic_preflight/stages/shellstage.py","response_note":"Fixed in commit 06bc482a: kill_process_tree repeats the signal on macOS only (sys.platform == 'darwin') and sends one signal on every other platform, as the finding suggests. Recorded as a note, not as --action fixed, because a later repair commit (6afb5c10, for F003) was already the branch tip and in-place mode accepts only the tip as a fix commit. The decision was the agent's: only macOS was measured, and the request is about the macOS failure.","severity":"low","stage":"review","status":"accepted","suggestion":"Limit the repeated kill to `sys.platform == \"darwin\"`, or confirm that the other targeted platforms behave like macOS when only zombies are left.","title":"On POSIX platforms other than macOS, an unreaped group leader can make every kill take the full two seconds","unit":"U0002"},{"action":"auto_fix","code_owned":false,"detail":"`_GROUP_KILL_SECONDS` is patched to 0.2, but the test only asserts that the call took under 30 seconds. A deadline that was ignored or scaled wrongly, for example 10 or 20 seconds, would still pass.","fix_commit":"6afb5c108d206b1913dbd9645f56ccff34c27f34","id":"F003","line":812,"path":"tests/test_shell_stages.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Assert a bound that fits the patched deadline, such as under 2 seconds.","title":"The give-up test's time bound is too loose to catch a broken deadline","unit":"U0008"}],"fingerprint":{"base_tree_sha":"cf2ba231293d1b49072e0b30d6650374379b9508","config_sha256":"25363ddc7d586ecf84e8f7f7fa372aa5c9e7aa56e8216e0ac04452b84d670e9c","configuration_supported":true,"diff_