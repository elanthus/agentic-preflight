","agentic_preflight/hook.py","agentic_preflight/risk.py","agentic_preflight/runs/publish.py"],"medium_risk_paths":["agentic_preflight/**","tests/**","skill/**"]},"pr":{"automated_cleanup":true,"mode":"auto"},"review":{"blocking_severities":["critical","high"],"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","executor":"command","max_findings":50,"require_command_for":[]},"stage":{"max_attempts":5,"max_restarts":5,"timeout_seconds":1500},"worktree":{"copy_files":[".env"],"mode":"in_place","root":null,"setup_command":null}},"findings":[{"action":"auto_fix","code_owned":false,"detail":"check_verified calls note_blob, and note_blob calls gitx.rev_parse and gitx.note_blobs. Either can raise GitError, and the CLI turns that into an evidence failure. The statement path catches the same errors and reports null, and check_verified already reports an unreadable note as 'absent'. So the same race either fails the command or passes it as absent, depending on where the error is raised.","fix_commit":"30fbf8e5963419a3378ff306a32ac24584e3ccec","id":"F001","line":69,"path":"agentic_preflight/cli_policy.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"In check_verified, catch GitError from note_blob and return SignatureCheck('absent', '', ...). That matches the 'note could not be read again' path.","title":"A Git error while re-reading the note during --signature fails a verify that already passed","unit":"U0009"},{"action":"no_op","code_owned":false,"detail":"signaturemod.statement and check_verified each call note_blob. If the notes ref changes between the two calls, data.statement.subject_sha256 and data.signature.note_sha256 describe different blobs in one envelope.","fix_commit":null,"id":"F002","line":62,"path":"agentic_preflight/cli_policy.py","response_note":"Fixed in 30fbf8e5, which this run already accounts for: the CLI reads the note blob once and passes the same bytes to the statement and the signature check, with a test.","severity":"low","stage":"review","status":"dismissed","suggestion":"Read the blob once and pass the bytes to both.","title":"statement and signature each read the note blob separately, so their digests can differ","unit":"U0009"},{"action":"auto_fix","code_owned":false,"detail":"","fix_commit":null,"id":"F003","line":1,"path":"tests/test_signature.py","response_note":"Fixed in 30fbf8e5, which this run already accounts for: the test module docstring now names the classifiers, verify --signature, the statement, and the sign job.","severity":"low","stage":"review","status":"dismissed","suggestion":"Widen the docstring to cover the signature check, the statement and the sign job.","title":"The module docstring describes only the classifiers, but the file also tests the CLI, the statement and the workflow","unit":"U0020"},{"action":"auto_fix","code_owned":false,"detail":"_branch removes only 'refs/heads/', 'refs/remotes/origin/' and 'origin/'. If [general] base_ref at the trusted base is 'refs/remotes/upstream/main' or 'upstream/main', the value passes through unchanged. check() then passes '--source-ref refs/heads/refs/remotes/upstream/main' (or 'refs/heads/upstream/main') to gh attestation verify. A note the protected workflow really signed then fails verification, and verify exits 2 with signature_invalid.","fix_commit":"ff853d64a320acb0ffb091a4b61023e7440d8049","id":"F006","line":172,"path":"agentic_preflight/signature.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Resolve the branch the same way verify resolves base_ref, or strip any 'refs/remotes/<remote>/' prefix. If the branch cannot be named, report absent with a detail rather than calling the signature invalid. Add a test for a non-origin remote prefix.","title":"_branch only strips an origin remote prefix, so other remote forms make the source-ref pin wrong","unit":"U0011"},{"action":"ask_user","code_owned":false,"detail":"repository_slug trusts GITHUB_REPOSITORY before it looks at origin. Every pin passed to gh (--repo, --signer-workflow, the lookup path) comes from that slug. The reader also does not compare the predicate (root_commit, sha, base_sha) with the clone. So a local caller who controls the environment can set GITHUB_REPOSITORY=attacker/fork. If that fork has its own attestation.yml that signed the same note bytes, the check reports verified, and nothing ties the signature to this repository. ADR 0004 put root_commit in the predicate so a reader could bind the signature to one repository. Without that comparison, the check binds to nothing.","fix_commit":"1473b295d99485b1985a05c1854fa39e404b249f","id":"F007","line":190,"path":"agentic_preflight/signature.py","response_note":null,"severity":"medium","stage":"review","status":"fixed","suggestion":"Either check that predicate.root_commit (and sha/base_sha) in the verified attestation matches the clone, or trust GITHUB_REPOSITORY only when GITHUB_ACTIONS is set. Also document that the repository name is something the caller supplies.","title":"A caller-set GITHUB_REPOSITORY can make --signature report verified using a signature from another repository","unit":"U0011"},{"action":"ask_user","code_owned":false,"detail":"classify_verify maps every non-zero exit from gh attestation verify to invalid. That call needs the network on its own (Sigstore TUF and trust-root fetches, an attestation fetch, rate limits), and it can fail for those reasons after the lookup succeeded. Only a timeout or a missing binary becomes absent. A network error, a 5xx or a rate limit during verify returns signature_invalid and exit 2. That contradicts the documented promise that invalid always means a signature exists and failed a check.","fix_commit":null,"id":"F008","line":150,"path":"agentic_preflight/signature.py","response_note":"Fixed in 1473b295, which this run already accounts for. The owner chose to retry: a failed