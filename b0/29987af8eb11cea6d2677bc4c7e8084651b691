light/cli_policy.py","agentic_preflight/hook.py","agentic_preflight/risk.py","agentic_preflight/runs/publish.py"],"medium_risk_paths":["agentic_preflight/**","tests/**","skill/**"]},"pr":{"automated_cleanup":true,"mode":"auto"},"review":{"blocking_severities":["critical","high"],"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","executor":"command","max_findings":50,"require_command_for":[]},"stage":{"max_attempts":5,"max_restarts":5,"timeout_seconds":1500},"worktree":{"copy_files":[".env"],"mode":"in_place","root":null,"setup_command":null}},"findings":[{"action":"auto_fix","code_owned":false,"detail":"`_diff_driver_config` runs `git config --get-regexp '^diff\\..+\\.(x?funcname|binary)$'` and builds a last-value-wins map of every driver's `binary` value. It then keeps only the drivers named `set`, `unset` or `unspecified`. When a binary file names a driver, `_refuse_local_diff_attributes` calls `_text_forcing_drivers`, which runs a second `git config --get-regexp '^diff\\..+\\.binary$'` and rebuilds the same map. That costs one more Git process on the hook path, and the two parsers can drift apart. One reads the driver with `rpartition` and the other with `rsplit`. Only the second excludes `default`.","fix_commit":"b029987af8eb11cea6d2677bc4c7e8084651b691","id":"F001","line":null,"path":"agentic_preflight/gitx.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Have `_diff_driver_config` return the full `binary` map, or the set of drivers that force text with `default` left out, along with the header set. Derive both the state-named refusal and the per-driver refusal from that one query, and delete `_text_forcing_drivers`.","title":"`binary` config is read twice: `_text_forcing_drivers` repeats the query `_diff_driver_config` already ran","unit":"U0016"},{"action":"auto_fix","code_owned":false,"detail":"In Git's parse_alt_odb_entry, a valid quoted entry is followed by one separator, which is skipped only if it is really there: `if (*end == sep) end++`. Parsing then carries on from whatever byte comes next. This code always skips one byte after the closing quote, so an entry like '\"a\"bc' becomes ['a', 'c'], where Git reads ['a', 'bc']. Git also checks for a '#' comment on the unquoted text. Here only the unquoted branch checks for '#', so the code keeps a quoted '\"#x\"' entry that Git ignores. In both cases the rewritten GIT_ALTERNATE_OBJECT_DIRECTORIES differs from what Git would resolve.","fix_commit":null,"id":"F002","line":null,"path":"agentic_preflight/gitx.py","response_note":"Probed Git 2.54 with real object stores: GIT_ALTERNATE_OBJECT_DIRECTORIES=\"\\\"<abs>/a\\\"bc\" makes Git read alternates a and c (one byte after the closing quote is skipped whatever it is), and \"\\\"#x\\\":<abs>/x\" reads both #x and x (a quoted entry is not a comment). _alternate_entries matches both; the independent Opus review matched 15 further inputs against Git.","severity":"low","stage":"review","status":"dismissed","suggestion":"After a successful unquote, advance past the next byte only if it is the separator. Treat the result as a comment if it starts with '#'. Add both cases to test_alternates_are_split_as_git_splits_them.","title":"_alternate_entries does not split quoted alternates exactly as Git does","unit":"U0016"}],"fingerprint":{"base_tree_sha":"bedf9037e69c8b2eaa5d6195464d1f492e65f263","config_sha256":"25363ddc7d586ecf84e8f7f7fa372aa5c9e7aa56e8216e0ac04452b84d670e9c","configuration_supported":true,"diff_sha256":"5e4d4fd98afe03dfa3df54a7e3765a278267d2b8d1b53a11d07310cb4a9be9c6","excluded_files":[],"executor":"command","grounding_sha256":"bfaedac60c85c6dfafb8a053b543a34515891c7869fa662a1fc86da0b2fd1047","head_tree_sha":"62735e94e424bfec4b07c967dfe4ea5cf6fe0273","intent_sha256":"cf0f08f85e1e5cd702a1d9d07526a0d7cf061ee1472b0c3005e72668db162309","version":2},"finished_at":"2026-11-16T20:45:26Z","head_sha":"b029