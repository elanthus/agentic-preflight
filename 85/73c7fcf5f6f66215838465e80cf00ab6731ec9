,"agentic_preflight/runs/publish.py"],"medium_risk_paths":["agentic_preflight/**","tests/**","skill/**"]},"pr":{"automated_cleanup":true,"mode":"auto"},"review":{"blocking_severities":["critical","high"],"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","executor":"command","max_findings":50,"require_command_for":[]},"stage":{"max_attempts":5,"max_restarts":5,"timeout_seconds":1500},"worktree":{"copy_files":[".env"],"mode":"in_place","root":null,"setup_command":null}},"findings":[{"action":"ask_user","code_owned":false,"detail":"_record_transcript runs after the findings_submitted event has been appended, and that event already names the new transcript's sha256 and byte size. If atomic_write then raises (disk full, permissions), the run has accepted the submission and its last findings_submitted names the new digest. But logs/<stage>-transcript.txt still holds the previous transcript, or does not exist, and no transcript_recorded event is appended. The submission also exits with an error even though it was accepted. The code and docs say 'a stage's transcript is the one its last submission names', and this case breaks that.","fix_commit":"f150573afd3ad08b970e8e57cd6cfaad823208b0","id":"F001","line":330,"path":"agentic_preflight/runs/review.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Decide whether the transcript file must always match the digest that findings_submitted names. If it must, write the file to a temporary path before the event and rename it after, or keep the current order and document that a reader confirms the file by checking for transcript_recorded and comparing digests.","title":"If the transcript write fails after findings_submitted, the log names a transcript the file does not hold","unit":"U0013"},{"action":"auto_fix","code_owned":false,"detail":"_stage_transcript calls atomic_write after apply_action(doc, SUBMIT_BLOCKING/SUBMIT_CLEAN) has saved the new state. If that write fails (out of space or no permission), the run is already REVIEW_GREEN or REVIEW_BLOCKED, but the closing findings_submitted event is never written. The change itself adds this failure point. The test covering the transcript_write failure only checks the transcript file and the events, not the run state, so it misses this. That conflicts with the stated goal that a refused transcript leaves the run unchanged.","fix_commit":"8573c7fcf5f6f66215838465e80cf00ab6731ec9","id":"F002","line":472,"path":"agentic_preflight/runs/review.py","response_note":null,"severity":"medium","stage":"review","status":"fixed","suggestion":"Write the .pending file before the state transition is saved, for example right after _redacted_transcript or before the locked doc update. Then only the rename runs after findings_submitted.","title":"Transcript is staged only after the run state has already advanced, so a failed staging write leaves the transition with no findings_submitted event","unit":"U0015"},{"action":"no_op","code_owned":false,"detail":"If the process dies after findings_submitted names transcript B but before _record_transcript renames the file, logs/<stage>-transcript.txt still holds the earlier transcript and B stays in the .pending file. In that case the rule that a stage's transcript is the one its last submission names does not hold. The window is small, and B is still recoverable from .pending.","fix_commit":null,"id":"F003","line":507,"path":"agentic_preflight/runs/review.py","response_note":null,"severity":"low","stage":"review","status":"open","suggestion":null,"title":"A crash between findings_submitted and os.replace leaves the log naming a transcript that is still in .pending","unit":"U0016"},{"action":"no_op","code_owned":false,"detail":"_record_transcript runs os.replace only after findings_submitted has been appended with the new transcript's sha256. If the process dies, or os.replace raises, between those two steps, the log names the new digest while logs/<stage>-transcript.txt still holds the previous submission's bytes or is missing. The new text survives only as a .pending file, and the next submission deletes or overwrites it. This leaves a reader unable to match the file to the digest, but no wrong transcript is passed off as the current one. The behaviour follows the stated ordering ('replaced only after that event').","fix_commit":null,"id":"F004","line":340,"path":"agentic_preflight/runs/review.py","response_note":null,"severity":"low","stage":"review","status":"open","suggestion":"Accept this window and document it. Or have readers treat a .pending file whose digest matches the last findings_submitted as the stored transcript, or finish the rename when the next command runs.","title":"A crash between findings_submitted and the rename leaves the stored transcript out of step with the log","unit":"U0013"}],"fingerprint":{"base_tree_sha":"4a002316dcca2f47201c9f8750b5ab20be6cd43b","config_sha256":"25363ddc7d586ecf84e8f7f7fa372aa5c9e7aa56e8216e0ac04452b84d670e9c","configuration_supported":true,"diff_sha256":"48677ddf14a98cc82bd842492ac998ebe027c98f5e90a61f25b0f8b895d41cfb","excluded_files":[],"executor":"command","grounding_sha256":"48d6442accea5d14ce1bd7be84d71e22945a1a786e0bab55507ce39836f8aed7","head_tree_sha":"ecfdf40caaab7da7ed111eeac01232f37c729efa","intent_sha256":"adf788d3865c10f44da6738829b596d102777dfabb43e1ecd7f536b25a20d83a","version":2},"finished_at":"2026-11-19T01:23:37Z","head_sha":"8573c7fcf5f6f66215838465e80cf00ab6731ec9","result":{"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","coverage":{"cited_units":["U0013"],"clean_units":["U0001","U0002","U0003","U0004","U0005","U0006","U0007","U0008","U0009","U0010","U0011","U0012","U0014","U0015","U0016","U0017","U0018","U0019","U0020","U0021","U0022","U0023","U0024","U0025","U0026"],"excluded_files":[],"grounding_sha256":"48d