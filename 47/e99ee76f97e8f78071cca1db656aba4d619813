tical","high"],"enabled":true,"paths":[],"require_changelog":false},"gate":{"mode":"token"},"general":{"base_ref":"main"},"hook":{"allow_force_push":true},"policy":{"high_risk_paths":[],"human_review_paths":[".agentic-preflight.toml",".github/CODEOWNERS",".github/dependabot.yml",".github/workflows/**",".github/scripts/verify_dependabot.py","SECURITY.md","agentic_preflight/approval.py","agentic_preflight/attestation.py","agentic_preflight/cli_policy.py","agentic_preflight/hook.py","agentic_preflight/risk.py","agentic_preflight/runs/publish.py"],"medium_risk_paths":["agentic_preflight/**","tests/**","skill/**"]},"pr":{"automated_cleanup":true,"mode":"auto"},"review":{"blocking_severities":["critical","high"],"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","executor":"command","max_findings":50,"require_command_for":[]},"stage":{"max_attempts":5,"max_restarts":5,"timeout_seconds":1500},"worktree":{"copy_files":[".env"],"mode":"in_place","root":null,"setup_command":null}},"findings":[{"action":"ask_user","code_owned":false,"detail":"The new SHA-256 check only runs after the force-push check. In a SHA-256 repository, a push that rewrites an existing remote branch while allow_force_push is false is blocked with force_push_refused and the usual force-push fix. That fix cannot help there. The user only sees 'SHA-256 repositories are not supported' after fixing the force push. The intent says such a push should get a clear unsupported message 'instead of a force-push or missing-run message'. docs/pre-push-hook.md also says a branch update that needs an attestation gets the SHA-256 message. Neither the code nor the docs say which check should come first.","fix_commit":"3b427405c0673152a2854758f9d5a2f9f8483882","id":"F001","line":273,"path":"agentic_preflight/hook.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Decide whether the SHA-256 check should run before the force-push check for non-exempt updates. If it should, move the length check above the forced computation and add a test for a rewriting push in a SHA-256 repository. If it should not, say in docs/pre-push-hook.md that a force push is still reported first.","title":"In a SHA-256 repository, a history-rewriting push gets the force-push message, not the unsupported-repository message","unit":"U0005"},{"action":"auto_fix","code_owned":false,"detail":"The new guard's condition is `not (not is_zero_id(update.remote_sha) and is_ancestor(update.local_sha, update.remote_sha))`. The ALREADY_ON_REMOTE check below repeats the same expression without the outer `not`. The double negative is hard to read, and nothing ties the two copies together. If one copy changes and the other does not, the SHA-256 guard and the already-on-remote exemption stop agreeing, and a SHA-256 push of a commit the remote already has could be blocked.","fix_commit":"3f17d14cf5ad42e9da3c955e75d0c67e78ef5965","id":"F002","line":253,"path":"agentic_preflight/hook.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Compute `already_on_remote = not is_zero_id(update.remote_sha) and is_ancestor(update.local_sha, update.remote_sha)` once. Then use `if len(update.local_sha) == SHA256_ID_LENGTH and not already_on_remote:` in the guard and `if already_on_remote:` in the check below.","title":"The SHA-256 guard repeats the already-on-remote condition as a double negative","unit":"U0004"},{"action":"auto_fix","code_owned":false,"detail":"The change adds is_zero_id() and ZERO_IDS as the single definition of Git's zero object ID. RefUpdate's deletion check (hook.py:136) still uses its own test, set(self.local_sha) == {\"0\"}. That test accepts any run of zeros, including '' and lengths other than 40 or 64. So the hook now has two definitions of a zero ID that disagree on malformed input. Deletions in SHA-256 repositories work only because the old check ignores length, not because it uses the new helper.","fix_commit":"47e99ee76f97e8f78071cca1db656aba4d619813","id":"F004","line":35,"path":"agentic_preflight/hook.py","response_note":null,"severity":"low","stage":"review","status":"fixed","suggestion":"Have the deletion check call is_zero_id(self.local_sha), so one helper defines the zero ID in both object formats.","title":"The new is_zero_id helper is not used for deletion detection, which keeps its own zero-ID check","unit":"U0003"}],"fingerprint":{"base_tree_sha":"0c72a29eefcd84e8150fc5a12b8579da4f314dd9","config_sha256":"47de23995384e97c1f2cfdaf65f0f5392e876c6a60064aa0be584ac5e453621c","configuration_supported":true,"diff_sha256":"1861551e169fa0429eaed0181ab6df45d8ee537e3cbfb54f150e30c29df38a84","excluded_files":[],"executor":"command","grounding_sha256":"e7f7b6a512cdc577fd77aec165bf52c1058e19f1bb05a921accf6afb9f937488","head_tree_sha":"91128fff9be42c14800533d8c78e3f93b1422c2d","intent_sha256":"e45adbd93becd4c1f3d1ae6cf192e2c6d048153868aae11e50035c0c5f9a5758","version":2},"finished_at":"2026-11-13T18:53:31Z","head_sha":"47e99ee76f97e8f78071cca1db656aba4d619813","result":{"command":"env AP_REVIEWER_MODEL=claude-opus-5-5 AP_REVIEWER_EFFORT=low uv run python -B docs/examples/reviewers/claude_review.py","coverage":{"cited_units":[],"clean_units":["U0001","U0002","U0003","U0004","U0005","U0006","U0007","U0008","U0009","U0010","U0011","U0012","U0013"],"excluded_files":[],"grounding_sha256":"e7f7b6a512cdc577fd77aec165bf52c1058e19f1bb05a921accf6afb9f937488","head_sha":"47e99ee76f97e8f78071cca1db656aba4d619813","manifest":"48333d98f4958081c34e1a1ade3c84100c5647aa52a889ed9a527c104ff61493","total_units":13},"executor":"command","exit_code":0,"output_sha256":"5e9263493d7ab11f6311b791bbf079c07955fe68d3f2929ebe20e038b2624f6c","reason":null,"status":"green"},"run_id":"r_462f2bc445","source_worktree_id":"d4e8ea67f3023704ac8fef59c8fbd1bb05c106c7ba80b219a53138e0d73b3b5a","stage":"review"},"origin_sha256":"1342333264dcdeb7025fc7a99b447a98f896826